# Copy file ini ke .env dan sesuaikan dengan konfigurasi lokal
# JANGAN commit .env ke repository, hanya commit .env.example

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=lapangan_booking
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_at_least_32_characters_long
JWT_EXPIRE=7d

# Payment Expiry (dalam menit)
PAYMENT_EXPIRY_MINUTES=15

# Email Configuration (SMTP)
# Option 1: Gmail (Recommended for testing)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_16_chars
EMAIL_FROM=Markas Lapangan <noreply@markaslapangan.com>

# Option 2: Custom Domain SMTP (Uncomment dan sesuaikan)
# EMAIL_USER=your_email@yourdomain.com
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_PASSWORD=your_email_password
# EMAIL_FROM=Your Name <email@yourdomain.com>

# API URL untuk link di email
API_URL=http://localhost:3000
